#!/usr/bin/python3
import subprocess
import threading
import time
import urllib.request

from model_profile_control import switch_profile

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk, Gio


PROFILES = {
    "fast": {
        "title": "Fast chat",
        "description": "0.5B model • text • 2K context • under-5-second target",
        "service": "orangepi-ai.service",
        "url": "http://127.0.0.1:8080/",
        "health": "http://127.0.0.1:8080/health",
    },
    "balanced": {
        "title": "Balanced chat",
        "description": "2B model • vision-capable • 4K context • advisory review",
        "service": "orangepi-ai-balanced.service",
        "url": "http://127.0.0.1:8083/",
        "health": "http://127.0.0.1:8083/health",
    },
    "quality": {
        "title": "Quality reasoning",
        "description": "4B model • vision-capable • 8K context • slower advisory review",
        "service": "orangepi-ai-quality.service",
        "url": "http://127.0.0.1:8081/",
        "health": "http://127.0.0.1:8081/health",
    },
    "long": {
        "title": "Long-context reasoning",
        "description": "Same 4B weights • text only • 12K context • slower review",
        "service": "orangepi-ai-long.service",
        "url": "http://127.0.0.1:8082/",
        "health": "http://127.0.0.1:8082/health",
    },
}


class AiLauncher(Gtk.Window):
    def __init__(self):
        super().__init__(title="Orange Pi AI Control Center")
        self.set_default_size(480, 600)
        self.set_border_width(10)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.connect("destroy", Gtk.main_quit)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.add(scroll)
        scroll.add(outer)

        title = Gtk.Label()
        title.set_markup("<span size='large' weight='bold'>Chat with your AI flight team</span>")
        title.set_xalign(0)
        outer.pack_start(title, False, False, 0)

        subtitle = Gtk.Label(
            label="Choose one local model. Your conversation stays on this board."
        )
        subtitle.set_xalign(0)
        outer.pack_start(subtitle, False, False, 0)

        self.buttons = []
        team = Gtk.Button()
        team.set_size_request(-1, 72)
        team_content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        team_heading = Gtk.Label()
        team_heading.set_markup("<b>Model review team</b>")
        team_heading.set_xalign(0)
        team_description = Gtk.Label(
            label="Fast draft • quality critique • long-context review • full audit"
        )
        team_description.set_xalign(0)
        team_content.pack_start(team_heading, False, False, 0)
        team_content.pack_start(team_description, False, False, 0)
        team.add(team_content)
        team.connect("clicked", self.open_team)
        self.buttons.append(team)
        outer.pack_start(team, False, False, 0)

        for profile, details in PROFILES.items():
            button = Gtk.Button()
            button.set_size_request(-1, 72)
            content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            heading = Gtk.Label()
            heading.set_markup(f"<b>{details['title']}</b>")
            heading.set_xalign(0)
            description = Gtk.Label(label=details["description"])
            description.set_xalign(0)
            content.pack_start(heading, False, False, 0)
            content.pack_start(description, False, False, 0)
            button.add(content)
            button.connect("clicked", self.on_profile_clicked, profile)
            outer.pack_start(button, False, False, 0)
            self.buttons.append(button)

        utilities = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        youtube = Gtk.Button(label="Open YouTube")
        youtube.connect("clicked", self.open_youtube)
        keyboard = Gtk.Button(label="Show / hide keyboard")
        keyboard.connect("clicked", self.show_keyboard)
        repair = Gtk.Button(label="Safe file repair")
        repair.connect("clicked", self.open_repair)
        utilities.pack_start(youtube, True, True, 0)
        utilities.pack_start(keyboard, True, True, 0)
        utilities.pack_start(repair, True, True, 0)
        outer.pack_start(utilities, False, False, 0)

        self.status = Gtk.Label(label="Fast AI starts automatically with the board.")
        self.status.set_xalign(0)
        # Text must wrap before sizing, so a narrow viewport can scroll vertically.
        def wrap_labels(widget):
            if isinstance(widget, Gtk.Label):
                widget.set_line_wrap(True)
                widget.set_max_width_chars(36)
            if isinstance(widget, Gtk.Container):
                for child in widget.get_children():
                    wrap_labels(child)
        outer.pack_end(self.status, False, False, 0)
        wrap_labels(outer)

    def set_busy(self, busy, message):
        for button in self.buttons:
            button.set_sensitive(not busy)
        self.status.set_text(message)

    def on_profile_clicked(self, _button, profile):
        details = PROFILES[profile]
        self.set_busy(True, f"Starting {details['title']}… Larger models may take several minutes.")
        threading.Thread(target=self.start_profile, args=(profile,), daemon=True).start()

    def start_profile(self, profile):
        details = PROFILES[profile]
        try:
            switch_profile(profile)
            GLib.idle_add(self.open_chat, details)
        except Exception as exc:
            GLib.idle_add(self.set_busy, False, f"Could not start the model: {exc}")

    def open_chat(self, details):
        self.set_busy(False, f"{details['title']} is ready.")
        subprocess.Popen(
            [
                "chromium",
                "--ozone-platform=x11",
                "--start-maximized",
                f"--app={details['url']}",
            ]
        )
        return False

    def open_youtube(self, _button):
        subprocess.Popen(
            [
                "chromium",
                "--ozone-platform=x11",
                "--start-maximized",
                "https://www.youtube.com/",
            ]
        )

    def show_keyboard(self, _button):
        try:
            bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
            bus.call_sync('org.onboard.Onboard', '/org/onboard/Onboard/Keyboard',
                          'org.onboard.Onboard.Keyboard', 'ToggleVisible', None, None,
                          Gio.DBusCallFlags.NONE, 1000, None)
        except GLib.Error:
            subprocess.Popen(["onboard"])

    def open_repair(self, _button):
        subprocess.Popen(["/home/drone/bin/orangepi-ai-repair-gui"])

    def open_team(self, _button):
        subprocess.Popen(["/home/drone/bin/orangepi-ai-team-gui"])


if __name__ == '__main__':
    window = AiLauncher()
    window.show_all()
    Gtk.main()
