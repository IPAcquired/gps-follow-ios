            and math.isfinite(heartbeat) and 0<=now-heartbeat<2)

def browser_desktop_input(command):
    kind=command['type']
    if kind in ('tap','drag'):
        w,h,_=desktop_capture.geometry()
        point=lambda x,y:(str(round(x*(w-1)/10000)),str(round(y*(h-1)/10000)))
        x,y=point(command['x'],command['y'])
        with REMOTE_INPUT.lock:
            if kind=='tap':REMOTE_INPUT._run('mousemove',x,y,'click','1' if command['button']=='left' else '3')
            else:
                ex,ey=point(command['end_x'],command['end_y'])
                try:REMOTE_INPUT._run('mousemove',x,y,'mousedown','1','mousemove',ex,ey,'mouseup','1')
                finally:REMOTE_INPUT._run('mouseup','1')
    elif kind=='scroll':REMOTE_INPUT.scroll(0,command['dy'])
    elif kind=='text':REMOTE_INPUT.text(command['text'])
    elif kind=='key':
        key=command['key']
        REMOTE_INPUT.key(key[5:],['ctrl']) if key.startswith('ctrl+') else REMOTE_INPUT.key(key)


def release_input_session(token: str) -> bool:
    with INPUT_LOCK:
        execution_lock = INPUT_EXECUTION_LOCKS.setdefault(token, threading.RLock())
    with execution_lock:
        with INPUT_LOCK:
            buttons = HELD_BUTTONS.pop(token, set())
            held_times = HELD_INPUT_TIMES.pop(token, None)
            INPUT_EVENTS.pop(token, None)
        failed: set[int] = set()
        for button in buttons:
            try:
                REMOTE_INPUT.button(button, False)
            except RuntimeError:
                failed.add(button)
        if failed:
            with INPUT_LOCK:
                HELD_BUTTONS.setdefault(token, set()).update(failed)
                now = time.monotonic()
                HELD_INPUT_TIMES[token] = held_times or (
                    now - HELD_INPUT_MAX_SECONDS, now - HELD_INPUT_IDLE_SECONDS
                )
            return False
    with AUTH_LOCK:
        session_still_valid = token in SESSIONS
    if not session_still_valid:
        with INPUT_LOCK:
            INPUT_EXECUTION_LOCKS.pop(token, None)
            LAST_INPUT_EVENT.pop(token, None)
    return True


def expire_sessions() -> int:
    now = time.monotonic()
    with AUTH_LOCK:
        expired = [key for key, (deadline, _, _) in SESSIONS.items() if deadline <= now]
        for key in expired:
            SESSIONS.pop(key, None)
    for key in expired:
        release_input_session(key)
    return len(expired)


def release_stale_input(now: float | None = None) -> int:
    """Release held pointer buttons after inactivity or an absolute hold limit."""
    checked_at = time.monotonic() if now is None else now
    with INPUT_LOCK:
        tokens = [
            token for token, buttons in HELD_BUTTONS.items()
            if buttons and token in HELD_INPUT_TIMES
            and (checked_at - HELD_INPUT_TIMES[token][1] >= HELD_INPUT_IDLE_SECONDS
                 or checked_at - HELD_INPUT_TIMES[token][0] >= HELD_INPUT_MAX_SECONDS)
        ]
    released = 0
    for token in tokens:
        with INPUT_LOCK:
            execution_lock = INPUT_EXECUTION_LOCKS.setdefault(token, threading.RLock())
        # Recheck while holding the same per-session lock as remote_input. A
        # move accepted while the sweeper waited must preserve an active drag.
        with execution_lock:
            with INPUT_LOCK:
                buttons = HELD_BUTTONS.get(token, set())
                times = HELD_INPUT_TIMES.get(token)
                stale = bool(buttons and times and (
                    checked_at - times[1] >= HELD_INPUT_IDLE_SECONDS
                    or checked_at - times[0] >= HELD_INPUT_MAX_SECONDS
                ))
            if not stale:
                continue
            if release_input_session(token):
                released += 1
    return released


def release_all_input() -> None:
    with INPUT_LOCK:
        tokens = list(HELD_BUTTONS)
    for token in tokens:
        release_input_session(token)
    # Recover from a prior process ending while a remote button was held.
    for button in (1, 2, 3):
        try:
            REMOTE_INPUT.button(button, False)
        except RuntimeError:
            pass


def session_sweeper(stop_event: threading.Event) -> None:
    while not stop_event.wait(1.0):
        expire_sessions()
        release_stale_input()
        PHONE_LOCATION.snapshot()  # Expire and erase stale in-memory phone coordinates.


def input_rate_allowed(token: str) -> bool:
    now = time.monotonic()
    with INPUT_LOCK:
        events = INPUT_EVENTS.setdefault(token, deque())
        while events and now - events[0] > 1.0:
            events.popleft()
        if len(events) >= 90:
            return False
        events.append(now)
    return True


def _advisory_number(value, minimum: float, maximum: float | None = None):
    """A missing, malformed or out-of-range reading is unknown, never zero."""
    if type(value) not in (int, float):
        return None
    try:
        if not math.isfinite(value) or value < minimum or (maximum is not None and value > maximum):
            return None
    except (TypeError, ValueError, OverflowError):
        return None
    return value


def deterministic_chat_reply(prompt: str, status: dict) -> str | None:
    """Handle safety-critical and live-state questions without trusting model compliance."""
    lowered = " ".join(prompt.lower().split())
    action_terms = (
        " set ", " change ", " write ", " disable ", " enable ", " arm ", " disarm ",
        "take off", "takeoff", " land ", "switch mode", "fly the", "move the",
        "send mavlink", "command the", "control the motors", "control the actuator",
    )
    flight_terms = (
        "ardupilot", "arming_check", "parameter", "flight mode", "flight controller",
        "h743", "motor", "actuator", "mavlink", "vehicle", "drone",
    )
    padded = f" {lowered} "
    if any(term in padded for term in action_terms) and any(term in lowered for term in flight_terms):
        return (
            "I will not execute that flight-control action or write ArduPilot parameters. "
            "The MicoAir H743 remains flight-authoritative; this Orange Pi is observation-only "
            "until the hardware is connected and a supervised bench test approves a specific integration."
        )
    if (
        any(term in lowered for term in ("authority", "authoritative", "which computer", "who controls"))
        and any(term in lowered for term in ("h743", "flight", "ardupilot", "drone"))
    ):
        return (
            "The MicoAir H743 retains all flight-critical authority. This Orange Pi may analyze "
            "sensor data and provide advisories, but it does not write parameters or directly command actuators."
        )
    if lowered == "how is offline learning configured?":
        learning = status.get("learning_review")
        if not isinstance(learning, dict):
            return "Learning status unavailable. No training or activation has been verified."
        waiting, total = learning.get("waiting_for_human_review"), learning.get("total_candidates")
        counts = (f"{waiting} waiting for review / {total} recorded candidates. "
                  if type(waiting) is int and type(total) is int and 0 <= waiting <= total
                  else "Candidate counts unavailable. ")
        training = learning.get("weight_training", {})
        battery = training.get("battery_prediction", {}) if isinstance(training, dict) else {}
        updated = isinstance(battery, dict) and battery.get("actual_weights_updated") is True
        return ("Offline learning review: " + counts +
                "Automatic candidate activation is disabled; human review is required. " +
                ("The latest battery-training report records a weight update. " if updated else
                 "No battery-model weight update is verified in the latest report. ") +
                "This button reads status only. H743 parameter writes are disabled.")
    if lowered == "which sensors are reporting verified data?":
        sensors = status.get("sensors", {})
        if not isinstance(sensors, dict): sensors = {}
        names = (("flight_controller", "H743"), ("camera", "camera"),
                 ("rplidar", "RPLiDAR"), ("matrix_lidar", "Matrix LiDAR"))
        fresh = [name for key, name in names if sensors.get(key) is True]
        missing = [name for key, name in names if sensors.get(key) is not True]
        return ("Fresh verified data: " + (", ".join(fresh) if fresh else "none") +
                ". No fresh verified data: " + (", ".join(missing) if missing else "none") +
                ". A USB port or configured sensor alone is not a live reading.")
    sensors = status.get("sensors", {})
    profile = status.get("flight_profile", {})
    flight = status.get("flight", {})
    if any(term in lowered for term in ("how did the flight", "how was the flight", "last flight", "flight went")):
        if not profile.get("files"):
            return (
                "I do not have a completed ArduPilot .BIN flight log yet, so I cannot honestly describe a flight. "
                "After a real log is uploaded, I can summarize its duration, messages, and measured behavior."
            )
    if any(term in lowered for term in ("current", "right now", "live", "connected", "frame rate", "fps")):
        requested = {
            "camera": ("camera", "frame rate", "fps"),
            "rplidar": ("rplidar", "rp lidar"),
            "matrix_lidar": ("matrix lidar", "dfrobot"),
            "flight_controller": ("flight controller", "h743"),
        }
        missing = [name for name, terms in requested.items() if any(term in lowered for term in terms) and not sensors.get(name)]
        if missing:
            names = ", ".join(name.replace("_", " ") for name in missing)
            return f"No fresh verified reading is available for {names}. A detected port alone does not prove working sensor data. I will not invent a reading."
    if any(term in lowered for term in ("armed", "flight mode", "vehicle state", "h743 status", "flight status")):
        if flight.get("connected") is not True:
            return "No fresh H743 heartbeat is available, so the current armed state and flight mode are unknown."
        armed = flight.get('armed')
        armed_text = ('armed' if armed else 'disarmed') if type(armed) is bool else 'armed state unknown'
        return (
            f"Fresh read-only H743 telemetry reports mode {flight.get('mode', 'unknown')} and "
            f"{armed_text}."
        )
    if "battery" in lowered and any(term in lowered for term in ("current", "right now", "live", "remaining")):
        battery = flight.get("battery", {}) if isinstance(flight.get("battery"), dict) else {}
        if flight.get("connected") is not True or battery.get('fresh') is not True:
            return "No fresh H743 battery telemetry is available, so I will not invent a battery value."
        pieces = []
        voltage = _advisory_number(battery.get("voltage_v"), 0)
        remaining = _advisory_number(battery.get("remaining_percent"), 0, 100)
        if voltage is not None and voltage > 0:
            pieces.append(f"{voltage} volts")
        if remaining is not None:
            pieces.append(f"{remaining}% remaining")
        if not pieces:
            return "The H743 heartbeat is available, but no usable fresh battery voltage or remaining percentage is available. I will not invent a battery value."
        return "Fresh read-only H743 telemetry reports " + " and ".join(pieces) + ". This is an observation, not a battery-health or flight-clearance decision."
    if any(term in lowered for term in ('what do you see', 'what can you see', 'surroundings',
                                        'environment', 'obstacles around', 'area clear')):
        # Recompute from source clocks, not a previously cached environment summary.
        return environment_awareness.describe(environment_awareness.summarize(
            status.get('vision', {}), status.get('flight', {})))
    return None


def unsafe_model_answer(text: str) -> bool:
    lowered = " ".join(text.lower().split())
    unsafe_claims = (
        "may write ardupilot", "can write ardupilot", "i will arm", "arming_check=0",
        "arm the motors now", "i have armed", "i changed the flight mode",
        "i sent the mavlink command", "orange pi retains flight-critical authority",
    )
    if any(claim in lowered for claim in unsafe_claims):
        return True
    negated = any(
        phrase in lowered
        for phrase in ("will not", "won't", "cannot", "can't", "must not", "do not", "does not")
    )
    flight_action = re.search(
        r"\b(set|change|write|disable|bypass|arm|disarm|take\s*off|land|send|command)\b.{0,100}"
        r"\b(ardupilot|arming_check|parameter|motor|actuator|mavlink|flight mode|vehicle)\b",
        lowered,
    ) or re.search(
        r"\b(ardupilot|arming_check|parameter|motor|actuator|mavlink|flight mode|vehicle)\b.{0,100}"
        r"\b(set|change|write|disable|bypass|arm|disarm|take\s*off|land|send|command)\b",
        lowered,
    )
    authority_claim = re.search(
        r"\b(i|we|orange pi|companion)\b.{0,60}\b(can|may|will)\b.{0,60}"
        r"\b(control|command|arm|write|change|send)\b",
        lowered,
    )
    return bool((flight_action or authority_claim) and not negated)


def read_text(path: Path, default: str = "") -> str:
    try:
        return path.read_text(encoding="utf-8").strip()
    except OSError:
        return default


def read_json(path: Path, default: dict | None = None) -> dict:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
        return value if isinstance(value, dict) else (default or {})
    except (OSError, json.JSONDecodeError):
        return default or {}


def ardupilot_reference_context(prompt: str) -> dict:
    metadata = read_json(ARDUPILOT_REFERENCE / 'reference.json', {})
    result = {key:metadata.get(key) for key in ('base_commit','last_install_evidence_date','source_files_verified','live_h743_version_match_verified','observed_h743_identity','live_base_commit_prefix_match','live_firmware_bytes_attested','runtime_autopilot_installed')}
    if not metadata: return {'status':'not_installed'}
    words = prompt.lower()
    choices = [('battery','ArduCopter/events.cpp'),('rangefinder','libraries/AP_RangeFinder/AP_RangeFinder_MAVLink.cpp'),('proximity','libraries/AP_Proximity/AP_Proximity_Utils.cpp'),('h743','libraries/AP_HAL_ChibiOS/hwdef/MicoAir743v2/hwdef.dat'),('failsafe','ArduCopter/events.cpp')]
    selected = next(((word,name) for word,name in choices if word in words),None)
    if selected and any(word in words for word in ('code','source','ardupilot','h743','firmware')):
        word, name = selected; path = ARDUPILOT_REFERENCE / 'source' / name
        try:
            raw = path.read_bytes()
            if hashlib.sha256(raw).hexdigest() != metadata.get('source_sha256', {}).get(name):
                return {**result,'source_status':'hash_mismatch_refused'}
            lines = raw.decode('utf-8',errors='replace').splitlines()
            matching = [f'{index+1}: {line[:200]}' for index,line in enumerate(lines) if word in line.lower()][:12]
            result.update({'source_file':name,'matching_lines':'\n'.join(matching)[:1600],'evidence_scope':'historical_custom_reference_not_live_firmware_verification'})
        except OSError: result['source_status']='unavailable'
    return result


def live_flight_status() -> dict:
    value = read_json(MAVLINK_STATUS)
    # Other telemetry may continue after autopilot heartbeats stop. A monitor
    # that publishes a dedicated heartbeat clock must be judged by that clock.
    now = time.time()
    updated = _advisory_number(value.get('last_heartbeat_unix'), 0, now + 5)
    valid_updated = updated is not None and updated > 0
    age_ms = max(0, int(round((now - float(updated)) * 1000))) if valid_updated else None
    valid_monitor = (type(value.get('schema')) is int and value['schema'] == 1
                     and value.get('authority') == 'read_only_no_mavlink_transmit'
                     and value.get('connected') is True)
    if not valid_monitor or not valid_updated or age_ms > 7000:
        return {
            "schema": 1, "connected": False, "reason": "no_fresh_heartbeat",
            "transport": "none", "connection_id": None, "flight_session_id": None,
            "armed": None, "mode": "unknown", "system_status": "unknown",
            "battery": {}, "batteries": {}, "battery_state": "no_fresh_heartbeat", "gps": {}, "motion": {}, "attitude": {}, "sensors": {}, "health": {},
            "messages": [], "authority": "read_only_no_mavlink_transmit",
            "updated_unix": float(updated) if valid_updated else None,
            "data_age_ms": age_ms, "stale_after_ms": 7000, "fresh": False,
        }
    result = dict(value)
    result.update({"data_age_ms": age_ms, "stale_after_ms": 7000, "fresh": True})
    # A missing or malformed armed field is unknown, never implicit disarmed.
    result['armed'] = value.get('armed') if type(value.get('armed')) is bool else None
    # Re-expire this advisory field even if the publisher stopped while its
    # heartbeat was still within 7 s. Native GPS_RAW_INT field TTL is 2 s;
    # neither heartbeat nor publication time substitutes for its sample clock.
    sensors = value.get('sensors', {})
    gps_record = sensors.get('GPS_RAW_INT:0', {}) if isinstance(sensors, dict) else {}
    if not isinstance(gps_record, dict): gps_record = {}
    gps_fields = gps_record.get('values', {})
    if not isinstance(gps_fields, dict): gps_fields = {}
    gps_clocks = gps_record.get('field_updated_unix', {})
    if not isinstance(gps_clocks, dict): gps_clocks = {}
    fix_stamp = _advisory_number(gps_clocks.get('fix_type'), 0, now)
    fix = gps_fields.get('fix_type')
    valid_fix = (gps_record.get('message_type') == 'GPS_RAW_INT'
                 and type(gps_record.get('instance')) is int and gps_record['instance'] == 0
                 and fix_stamp is not None and fix_stamp > 0 and now - fix_stamp <= 2.0
                 and type(fix) is int and 0 <= fix <= 8)
    result['gps'] = dict(value['gps']) if isinstance(value.get('gps'), dict) else {}
    result['gps']['fix_type'] = fix if valid_fix else None
    def fresh_battery(record):
        if not isinstance(record, dict): return {}
        stamp_value = _advisory_number(record.get('updated_unix'), 0, now + 1)
        valid = stamp_value is not None and stamp_value > 0
        battery_age = max(0, int(round((now - stamp_value) * 1000))) if valid else None
        metadata = {key: record[key] for key in ('source_system_id', 'source_component_id', 'battery_id', 'identity_basis', 'message_type', 'updated_unix') if key in record}
        if not valid: metadata['updated_unix'] = None
        if not valid or battery_age > 5000:
            return {**metadata, 'fresh': False, 'data_age_ms': battery_age, 'stale_after_ms': 5000}
        return {**record, 'fresh': True, 'data_age_ms': battery_age, 'stale_after_ms': 5000}
    battery = fresh_battery(value.get('battery', {}))
    primary_valid = battery.get('fresh') is True and battery.get('battery_id', 0) == 0
    result['battery'] = battery if primary_valid else {}
    result['battery_state'] = 'fresh' if primary_valid else 'stale_or_unknown'
    result['battery_data_age_ms'] = battery.get('data_age_ms')
    result['battery_stale_after_ms'] = 5000
    records = value.get('batteries', {})
    result['batteries'] = {key: fresh_battery(record) for key, record in records.items() if isinstance(key, str) and re.fullmatch(r'\d{1,3}:\d{1,3}:\d{1,3}', key)} if isinstance(records, dict) else {}
    return result


def vision_status() -> dict:
    """Report-only camera context; stale or malformed frames never stay live."""
    value = read_json(VISION_STATUS)
    now = time.time()
    updated, captured = value.get('updated_unix'), value.get('captured_unix')
    valid_clocks = all(type(stamp) in (int, float) and math.isfinite(stamp)
                       and 0 < stamp <= now + 0.25 for stamp in (updated, captured))
    valid_clocks = valid_clocks and captured <= updated + 0.25
    age_ms = max(0, round((now - captured) * 1000)) if valid_clocks else None
    fresh = (type(value.get('schema')) is int and value['schema'] == 1
             and value.get('authority') == 'observation_only_no_flight_commands'
             and value.get('status') == 'active' and valid_clocks and age_ms <= 2000)
    result = {'schema': 1, 'status': 'active' if fresh else 'stale_or_unavailable',
              'fresh': bool(fresh), 'data_age_ms': age_ms, 'stale_after_ms': 2000,
              'captured_unix': captured if fresh else None, 'updated_unix': updated if fresh else None,
              'detections': [], 'authority': 'observation_only_no_flight_commands'}
    if fresh and isinstance(value.get('detections'), list):
        for row in value['detections'][:100]:
            if not isinstance(row, dict): continue
            box, confidence, class_id = row.get('box'), row.get('confidence'), row.get('class_id')
            if (not isinstance(box, list) or len(box) != 4
                    or any(type(item) not in (int, float) or not math.isfinite(item)
                           or not 0 <= item <= 65535 for item in box)
                    or box[2] <= box[0] or box[3] <= box[1]
                    or type(confidence) not in (int, float) or not math.isfinite(confidence)
                    or not 0 <= confidence <= 1 or type(class_id) is not int
                    or not 0 <= class_id <= 9999 or not isinstance(row.get('label'), str)):
                continue
            result['detections'].append({'class_id': class_id, 'label': row['label'][:80],
                                         'confidence': confidence, 'box': box})
    return result


def run(*command: str, timeout: float = 3.0) -> str:
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=timeout, check=False)
        return result.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def connector_status() -> dict[str, str]:
    result = {}
    for status in Path("/sys/class/drm").glob("card*-*/status"):
        result[status.parent.name] = read_text(status, "unknown")
    return result


def device_exists(*paths: str) -> bool:
    return any(Path(path).exists() for path in paths)


def sensor_observation_status(flight: dict, vision: dict) -> tuple[dict, dict, dict]:
    """Keep device-node visibility separate from validated fresh observations.

    The existing C1 bench marker has no sample time or validated ongoing scan
    producer. Neither it nor a tty alias can qualify live C1 or Matrix data.
    """
    nodes = {
        'camera': device_exists('/dev/camera', '/dev/video0'),
        'rplidar': device_exists('/dev/rplidar', '/dev/rplidar-c1-usb'),
        'matrix_lidar': device_exists('/dev/matrix-lidar', '/dev/dfrobot-matrix-lidar',
                                      '/dev/dfrobot-matrix-uart7'),
        'flight_controller': device_exists('/dev/h743', '/dev/rfcomm0'),
    }
    sensors = {
        'camera': vision.get('fresh') is True and vision.get('status') == 'active',
        'rplidar': False,
        'matrix_lidar': False,
        'flight_controller': flight.get('fresh') is True and flight.get('connected') is True,
    }
    health = {}
    for key, fresh in sensors.items():
        observation = vision if key == 'camera' else flight if key == 'flight_controller' else {}
        health[key] = {
            'status': 'fresh_data' if fresh else 'no_data',
            'fresh': fresh, 'device_node_present': nodes[key],
            'data_age_ms': observation.get('data_age_ms'),
            'reason': ('fresh_camera_capture' if key == 'camera' else 'fresh_h743_heartbeat') if fresh
                      else 'no_validated_live_producer' if key in {'rplidar', 'matrix_lidar'}
                      else 'no_fresh_capture' if key == 'camera' else 'no_fresh_heartbeat',
            'qualification': 'observation_only_not_flight_qualified',
        }
    # Retain the legacy readiness field for clients, but never count it as a
    # sensor observation or include it in the AI's sensors_online evidence.
    sensors['rplidar_port_ready'] = nodes['rplidar']
    return sensors, nodes, health


def update_status() -> dict:
    """Return the small, non-secret status published by root maintenance."""
    value = read_json(UPDATE_STATUS, {})
    try:
        policy = wifi_helper({'action': 'update_policy_status'})
    except (OSError, ValueError):
        policy = {'enabled': False, 'status': 'unavailable'}
    allowed_states = {"waiting_for_home_wifi", "checking", "installing_security", "verifying", "complete", "error"}
    state = value.get("state") if value.get("state") in allowed_states else "waiting_for_home_wifi"
    packages = value.get("pending_packages", [])
    if not isinstance(packages, list):
        packages = []
    packages = [str(item)[:120] for item in packages[:20] if isinstance(item, str)]
    try:
        count = max(0, min(10000, int(value.get("pending_count", len(packages)))))
    except (TypeError, ValueError):
        count = len(packages)
    return {
        "state": state,
        "detail": str(value.get("detail", "Connect to the configured home Wi-Fi to check for updates."))[:240],
        "checked_utc": str(value.get("checked_utc", ""))[:40],
        "pending_count": count,
        "pending_packages": packages,
        "security_updates_automatic": policy.get("enabled") is True,
        "auto_update_policy": policy,
        "driver_updates": "inventory_and_review_only",
        "driver_update_candidates": [item for item in packages if any(term in item.lower() for term in ('linux-', 'firmware', 'orangepi', 'aic8800', 'npu', 'gpu'))],
        "ai_runtime_update_candidates": [item for item in packages if any(term in item.lower() for term in ('llama', 'torch', 'onnx', 'transformer', 'numpy'))],
        "availability_scope": "last_package_inventory_not_vendor_or_model_catalog",
        "broader_update_review_required": True,
        "ai_runtime_updates": "inventory_and_review_only",
        "model_weight_promotion": False,
        "kernel_boot_firmware_require_review": True,
        "automatic_reboot": False,
        "flight_activity_blocks_maintenance": True,
    }


def weight_training_status() -> dict:
    """Bounded report-only status: never expose datasets, errors or model paths."""
    def bounded_status(path: Path, maximum: int) -> dict:
        try:
            if path.is_symlink() or path.stat().st_size > maximum: return {}
            value = json.loads(path.read_text(encoding='utf-8'))
            return value if isinstance(value, dict) else {}
        except (OSError, ValueError): return {}
    value = bounded_status(WEIGHT_TRAINING_ROOT / 'status.json', 16384)
    config = bounded_status(WEIGHT_TRAINING_CONFIG, 4096)
    states = {'offline_installed_boot_pending', 'disabled', 'waiting_for_labels', 'waiting_for_reviewed_data', 'waiting_for_reviewed_data_or_valid_provenance', 'waiting_for_data_or_review', 'training_data_preparation', 'waiting_for_labels_or_resources', 'waiting_for_resources', 'waiting_for_bench', 'training_neural', 'training_qwen', 'qwen_job_ready', 'ready_for_review_or_waiting_for_data', 'awaiting_human_review', 'validation_failed', 'paused_or_rejected', 'neural_weights_approved', 'candidate_created', 'completed_or_unchanged'}
    result = {'state': value.get('state') if isinstance(value.get('state'), str) and value['state'] in states else 'not_reported',
              'configuration': {key: config.get(key) is True for key in ('automatic_neural_training', 'automatic_qwen_job_preparation', 'automatic_qwen_training', 'automatic_battery_prediction_training')},
              'automatic_training_requested': value.get('automatic_training_requested') is True,
              'automatic_activation': False, 'flight_authority': False,
              'live_runtime_verified_by_this_api': False}
    stamp_value = value.get('updated_unix')
    if type(stamp_value) in (int, float) and math.isfinite(stamp_value) and 0 < stamp_value <= time.time() + 60:
        result['updated_unix'] = stamp_value
    for key in ('epoch', 'total_epochs', 'training_samples', 'held_out_samples'):
        if type(value.get(key)) is int and 0 <= value[key] <= 100_000_000: result[key] = value[key]
    cid = value.get('candidate_id')
    if isinstance(cid, str) and re.fullmatch('[0-9a-f]{24}', cid): result['candidate_id'] = cid
    pipeline_values = {'completed_or_unchanged', 'waiting_for_reviewed_data_or_valid_provenance', 'waiting_for_labels', 'waiting_for_resources', 'waiting_for_bench', 'training', 'training_neural', 'candidate_created', 'awaiting_human_review', 'validation_failed', 'qwen_job_ready', 'waiting_data', 'waiting_for_data_or_review', 'disabled'}
    pipelines = value.get('pipelines', {})
    result['pipelines'] = {key: pipelines[key] for key in ('neural', 'qwen') if isinstance(pipelines, dict) and isinstance(pipelines.get(key), str) and pipelines[key] in pipeline_values}
    raw_battery = bounded_status(WEIGHT_TRAINING_ROOT / 'battery' / 'status.json', 65536)
    battery_states = {'offline_installed_boot_pending', 'waiting_actual_battery_telemetry', 'waiting_more_valid_measured_pairs', 'candidate_training_completed', 'diagnostic_candidate_ready', 'waiting_for_resources', 'paused_or_rejected', 'checking_completed_real_logs', 'preparing_measured_voltage_targets', 'training_candidate_weights', 'candidates_ready_for_review', 'waiting_more_valid_measured_voltage', 'waiting_completed_analyzer_archive', 'waiting_model_or_training_lock', 'paused_safety_resource_or_data_integrity', 'disabled_by_configuration'}
    battery = {'state': raw_battery.get('state') if isinstance(raw_battery.get('state'), str) and raw_battery['state'] in battery_states else 'not_reported',
               'automatic_activation': False, 'eligible_for_promotion': False}
    reports = raw_battery.get('trained_candidates')
    has_full_reports = isinstance(reports, list)
    reports = [report for report in reports if isinstance(report, dict)] if has_full_reports else []
    candidates = [report for report in reports if report.get('state') == 'diagnostic_candidate_ready' and report.get('weights_changed') is True]
    def count(key: str) -> int | None:
        number = raw_battery.get(key)
        return number if type(number) is int and 0 <= number <= 100_000_000 else None
    if has_full_reports:
        battery.update({'dataset_count': len(reports), 'candidate_count': len(candidates),
                        'trained_count': len(candidates),
                        'trained_this_run': sum(report.get('training_performed_this_run') is True for report in candidates),
                        'waiting_count': len(reports) - len(candidates),
                        'training_rows': sum(report.get('training_rows', 0) for report in candidates if type(report.get('training_rows')) is int and 0 <= report['training_rows'] <= 100_000_000),
                        'validation_rows': sum(report.get('validation_rows', 0) for report in candidates if type(report.get('validation_rows')) is int and 0 <= report['validation_rows'] <= 100_000_000),
                        'row_aggregate_scope': 'retained_diagnostic_candidates_only'})
    else:
        trained_count = count('trained_count')
        legacy_candidate_count = count('candidate_count')
        candidate_count = trained_count if trained_count is not None else (legacy_candidate_count or 0)
        dataset_count = count('dataset_count')
        battery['dataset_count'] = dataset_count if dataset_count is not None else (legacy_candidate_count if legacy_candidate_count is not None else candidate_count)
        battery['candidate_count'] = candidate_count
        battery['trained_count'] = candidate_count
        for key in ('trained_this_run', 'waiting_count'):
            number = count(key)
            if number is not None: battery[key] = number
        row_scope = raw_battery.get('row_aggregate_scope')
        training_rows = count('training_rows') if count('training_rows') is not None else count('summed_training_rows')
        validation_rows = count('validation_rows') if count('validation_rows') is not None else count('summed_validation_rows')
        if row_scope == 'retained_diagnostic_candidates_only':
            if training_rows is not None: battery['training_rows'] = training_rows
            if validation_rows is not None: battery['validation_rows'] = validation_rows
            battery['row_aggregate_scope'] = row_scope
        elif training_rows is not None or validation_rows is not None:
            # Legacy compact status summed waiting/attempted partitions too.
            # Preserve compatibility without labelling those rows as trained.
            if training_rows is not None: battery['attempted_training_rows'] = training_rows
            if validation_rows is not None: battery['attempted_validation_rows'] = validation_rows
            battery['row_aggregate_scope'] = 'attempted_dataset_partitions'
    for key in ('actual_voltage_rows', 'current_measured_pairs', 'current_unknown_pairs', 'completed_new_logs', 'previously_prepared_logs'):
        if type(raw_battery.get(key)) is int and 0 <= raw_battery[key] <= 100_000_000: battery[key] = raw_battery[key]
    # This field describes only the most recently reported run. Retained
    # candidates from earlier runs are not evidence of a current weight update.
    battery['actual_weights_updated'] = raw_battery.get('actual_weights_updated') is True
    battery_stamp = raw_battery.get('updated_unix')
    if type(battery_stamp) in (int, float) and math.isfinite(battery_stamp) and 0 < battery_stamp <= time.time() + 60: battery['updated_unix'] = battery_stamp
    result['battery_prediction'] = battery
    return result


def learning_review_status() -> dict:
    """Expose review state without exposing prompts, raw logs, or writable actions."""
    queues = (
        ("flight_policy", FLIGHT_LEARNING_ROOT / "candidates", FLIGHT_LEARNING_ROOT / "decisions"),
        ("fast_model_policy", AI_IMPROVEMENT_ROOT / "pending", AI_IMPROVEMENT_ROOT / "decisions"),
    )
    items = []
    for kind, candidate_root, decision_root in queues:
        for path in sorted(candidate_root.glob("*.json"))[-100:]:
            candidate = read_json(path, {})
            if not isinstance(candidate, dict): continue
            evaluation = candidate.get('evaluation', {})
            if not isinstance(evaluation, dict): evaluation = {}
            candidate_id = str(candidate.get("candidate_id", path.stem))[:64]
            decision = read_json(decision_root / path.name, {})
            if not isinstance(decision, dict): decision = {}
            items.append(
                {
                    "kind": kind,
                    "candidate_id": candidate_id,
                    "status": str(decision.get("decision", candidate.get("status", "unknown")))[:80],
                    "created_utc": str(candidate.get("created_utc", evaluation.get("tested_utc", "")))[:40],
                    "human_decision_required": not bool(decision),
                }
            )
    waiting = sum(1 for item in items if item["status"] == "awaiting_human_review")
    return {
        "schema": 1,
        "waiting_for_human_review": waiting,
        "total_candidates": len(items),
        "latest": items[-10:],
        "automatic_activation": False,
        "h743_parameter_writes": False,
        "weight_training": weight_training_status(),
        "offline_code_review": read_json(Path('/home/drone/.local/state/orangepi-code-review/latest.json'), {'status': 'not_checked'}),
    }


def flight_insights() -> dict:
    """Build bounded, explainable, read-only flight and log advisories."""
    profile = read_json(PROFILE, {})
    flight = live_flight_status()
    updates = update_status()
    jev_review = read_json(JEV_FLIGHT_REVIEW, {})
    learning = learning_review_status()
    advisories: list[dict[str, str]] = []

    def add(level: str, title: str, explanation: str, evidence: str) -> None:
        advisories.append({
            "level": level, "title": title, "explanation": explanation,
            "evidence": evidence, "action": "Review only â€” no automatic flight or parameter change",
        })

    if flight.get("connected") is True:
        battery = flight.get("battery", {}) if isinstance(flight.get("battery"), dict) else {}
        gps = flight.get("gps", {}) if isinstance(flight.get("gps"), dict) else {}
        remaining = (_advisory_number(battery.get("remaining_percent"), 0, 100)
                     if battery.get('fresh') is True else None)
        if remaining is not None and remaining < 20:
            add("warning", "Battery reserve is low", "Plan a safe landing using the flight controller and pilot procedures.", f"Fresh telemetry reports {remaining}% remaining.")
        fix = gps.get("fix_type")
        # GPS enum values are integers. The monitor expires individual GPS
        # fields independently of the heartbeat; expired fix_type is None.
        fix = fix if type(fix) is int and 0 <= fix <= 8 else None
        if fix is not None and fix < 3:
            add("warning", "GPS fix is not ready", "Wait for a stable 3D fix before relying on position-dependent modes.", f"Fresh telemetry fix type is {int(fix)}.")
        missing = []
        if remaining is None: missing.append("battery remaining percentage")
        if fix is None: missing.append("GPS fix type")
        if missing:
            add("info", "Live advisory telemetry is incomplete", "A heartbeat does not prove usable battery or GPS measurements; missing rules cannot be evaluated.", "Unavailable or invalid: " + ", ".join(missing) + ".")
        if not advisories:
            add("info", "Available telemetry crossed no displayed warning rule", "Keep monitoring; this does not establish battery health, GPS reliability, hardware qualification or flight clearance.", "The available battery percentage and GPS fix enum did not cross these two advisory thresholds.")
    else:
        add("info", "H743 telemetry is waiting", "Connect the MicoAir H743 to see live, fresh-flight data.", "No fresh MAVLink heartbeat is available.")

    def count_field(name: str):
        value = profile.get(name, 0)
        return value if type(value) is int and 0 <= value <= 2**63-1 else None
    files = count_field('files')
    if files == 0:
        add("info", "No completed flight log yet", "Upload an ArduPilot .BIN after landing for an understandable post-flight summary.", "The analyzed log count is zero.")
    elif files is not None:
        messages = count_field('messages')
        add("good", "Post-flight history is ready", "Review the measured ranges below before considering any supervised change.", f"{files} log file(s); message count {'unknown' if messages is None else f'{messages:,}'}.")
    else:
        add("warning", "Flight profile metadata is unavailable", "Refresh after the analyzer verifies the completed records; stored logs were not changed.", "The aggregate file counter is malformed, so no count is asserted.")
    if updates["pending_count"]:
        add("info", "Software updates are available", "Return to the app while on home Wi-Fi to review the update list.", f"{updates['pending_count']} package update(s) are reported.")
    if jev_review.get("real_jev_called") is True and isinstance(jev_review.get("result"), dict):
        result = jev_review["result"]
        priority = str(result.get("priority", "insufficient_evidence")).replace("_", " ")
        confidence = float(result.get("priority_confidence", 0) or 0)
        sufficient = float(result.get("evidence_sufficient_probability", 0) or 0)
        if confidence >= 0.80 and sufficient >= 0.70:
            add("info", f"Jev review: {priority}", "This is a structured post-flight judgment over aggregate statistics; inspect the named measurements before acting.", f"Priority confidence {confidence:.0%}; evidence-sufficiency probability {sufficient:.0%}.")
        else:
            add("info", "Jev requested human review", "The hosted model did not provide enough confidence and evidence for a specific suggestion.", f"Priority confidence {confidence:.0%}; evidence-sufficiency probability {sufficient:.0%}.")
    if learning["waiting_for_human_review"]:
        add(
            "info", "Learning candidates are ready for your review",
            "The models preserved their tested suggestions without activating them.",
            f"{learning['waiting_for_human_review']} candidate(s) are waiting; automatic activation is disabled.",
        )

    message_types = profile.get("message_types", {})
    if not isinstance(message_types, dict):
        message_types = {}
    top_messages = [
        {"name": str(name)[:40], "count": int(count)}
        for name, count in sorted(((name, count) for name, count in message_types.items()
                                   if type(count) is int and 0 <= count <= 2**63-1), key=lambda item: item[1], reverse=True)[:12]
    ]
    numeric_fields = profile.get("numeric_fields", {})
    if not isinstance(numeric_fields, dict):
        numeric_fields = {}
    measurements = []
    for name, values in sorted(
        ((name, values) for name, values in numeric_fields.items() if isinstance(values, dict)
         and type(values.get('count')) is int and 0 <= values['count'] <= 2**63-1),
        key=lambda item: item[1]['count'],
        reverse=True,
    )[:16]:
        if not isinstance(values, dict):
            continue
        try:
            numbers = [values.get(key) for key in ('minimum', 'mean', 'maximum')]
            if any(type(number) not in (int, float) or not math.isfinite(number) for number in numbers): continue
            measurements.append({
                "name": str(name)[:80], "count": max(0, int(values.get("count", 0))),
                "minimum": round(float(values.get("minimum", 0)), 4),
                "mean": round(float(values.get("mean", 0)), 4),
                "maximum": round(float(values.get("maximum", 0)), 4),
            })
        except (TypeError, ValueError, OverflowError):
            continue
    inbox_count = sum(1 for path in INBOX.glob("*.bin") if path.is_file())
    analyzer = read_json(ANALYZER_RUN, {})
    return {
        "generated_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "processing": {"queued_bin_files": inbox_count, "state": "analyzing_or_waiting_for_safe_close" if inbox_count else "idle", "last_run_utc": str(analyzer.get("run_utc", ""))[:40]},
        "profile": {
            "files": files, "bytes": count_field('bytes'),
            "messages": count_field('messages'),
            "duration_seconds": profile.get('duration_seconds', 0) if type(profile.get('duration_seconds', 0)) in (int, float) and math.isfinite(profile.get('duration_seconds', 0)) and profile.get('duration_seconds', 0) >= 0 else None,
            "generated_utc": str(profile.get("generated_utc", ""))[:40],
            "top_message_types": top_messages, "measurements": measurements,
        },
        "advisories": advisories[:12],
        "learning_review": learning,
        "authority": {"read_only": True, "may_write_ardupilot_parameters": False, "may_emit_actuator_commands": False},
    }



