    sweeper.start()
    # A dedicated loopback listener makes SSH over USB/LAN independent of ap0.
    # The AP listener retries as its address appears; never bind 0.0.0.0.
    server = CompanionServer(('127.0.0.1', PORT), Handler)
    ap_servers: list[CompanionServer] = []

    def serve_private_ap() -> None:
        if HOST == '127.0.0.1': return
        if HOST != '192.0.2.10': return  # no arbitrary LAN exposure
        while not stop_event.is_set():
            try:
                ap = CompanionServer((HOST, PORT), Handler)
                ap_servers.append(ap)
                try: ap.serve_forever()
                finally: ap.server_close()
                return
            except OSError:
                stop_event.wait(3)

    threading.Thread(target=serve_private_ap, daemon=True).start()

    def stop_server(_signum, _frame) -> None:
        stop_event.set()
        threading.Thread(target=server.shutdown, daemon=True).start()
        for ap in ap_servers: threading.Thread(target=ap.shutdown, daemon=True).start()

    signal.signal(signal.SIGTERM, stop_server)
    signal.signal(signal.SIGINT, stop_server)
    try:
        server.serve_forever()
    finally:
        stop_event.set()
        server.server_close()
        release_all_input()

