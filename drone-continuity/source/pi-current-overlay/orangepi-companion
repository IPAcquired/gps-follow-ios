def display_access_point():
    """Actual AP interface identity; safe in the AF_NETLINK-restricted service."""
    from display_transport import interface_ipv4
    try:
        address=interface_ipv4('ap0')
        bssid=Path('/sys/class/net/ap0/address').read_text().strip().lower()
        flags=int(Path('/sys/class/net/ap0/flags').read_text().strip(),16)
        if address!='192.0.2.10' or not re.fullmatch(r'(?:[0-9a-f]{2}:){5}[0-9a-f]{2}',bssid):return {'active':False}
        return {'active':bool(flags&1),'ip':address,'bssid':bssid}
    except (OSError,ValueError):
        return {'active':False}


