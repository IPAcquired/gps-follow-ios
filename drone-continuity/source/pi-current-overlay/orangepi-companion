class Handler(BaseHTTPRequestHandler):
    server_version = "OrangePiCompanion/1"
    sys_version = ""
    protocol_version = "HTTP/1.1"
    disable_nagle_algorithm = True

    def setup(self) -> None:
        super().setup()
        self.connection.settimeout(15)

    def handle_one_request(self) -> None:
        # HTTP/1.1 may reuse one handler connection for many requests. Reset
        # latency and correlation metadata for every request, not only once
        # when the TCP connection is accepted.
        self.request_started = time.perf_counter()
        self.request_id = secrets.token_hex(6)
        super().handle_one_request()

    def version_string(self) -> str:
        return self.server_version

    def log_message(self, format: str, *args) -> None:
        # Never log raw request lines: an unread rejected POST body can be
        # parsed as the next HTTP/1.1 request and could contain a Wi-Fi secret.
        print('%s - request %s' % (self.address_string(), getattr(self, 'request_id', 'unknown')), flush=True)

    def security_headers(self, *, json_response: bool = False) -> None:
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("Cross-Origin-Resource-Policy", "same-origin")
        self.send_header("Permissions-Policy", "camera=(), microphone=(), geolocation=()")
        if json_response:
            self.send_header("Content-Security-Policy", "default-src 'none'; frame-ancestors 'none'")

    def send_json(self, status: int, value: dict, extra_headers: dict[str, str] | None = None) -> None:
        body = json.dumps(value, separators=(",", ":")).encode()
        elapsed_ms = max(0.0, (time.perf_counter() - self.request_started) * 1000)
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        if status >= 400:
            self.close_connection = True
            self.send_header('Connection', 'close')
        self.security_headers(json_response=True)
        self.send_header("X-OrangePi-Request-Id", self.request_id)
        self.send_header("X-OrangePi-Server-Unix-Ms", str(int(time.time() * 1000)))
        self.send_header("X-OrangePi-Processing-Ms", f"{elapsed_ms:.3f}")
        for name, header_value in (extra_headers or {}).items():
            self.send_header(name, header_value)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def send_error(self, code: int, message: str | None = None, explain: str | None = None) -> None:
        try:
            label = HTTPStatus(code).phrase
        except ValueError:
            label = "Request failed"
        self.send_json(code, {"error": label})

    def authenticated(self) -> bool:
        supplied = self.headers.get("Authorization", "").removeprefix("Bearer ").strip()
        now = time.monotonic()
        expire_sessions()
        with AUTH_LOCK:
            session = SESSIONS.get(supplied)
        return bool(session and session[0] > now and session[1] == self.client_address[0])

    def session_token(self) -> str:
        return self.headers.get("Authorization", "").removeprefix("Bearer ").strip()

    def login(self) -> None:
        ip = self.client_address[0]
        now = time.monotonic()
        try:
            config = json.loads(AUTH_FILE.read_text(encoding="utf-8"))
            with AUTH_LOCK:
                failures = [stamp for stamp in FAILURES.get(ip, []) if now - stamp < int(config["failure_window_seconds"])]
                FAILURES[ip] = failures
            if len(failures) >= int(config["max_failed_logins"]):
                retry_after = max(1, int(config["failure_window_seconds"] - (now - min(failures))))
                self.send_json(HTTPStatus.TOO_MANY_REQUESTS, {
                    "error": f"Too many failed logins. Try again in {retry_after} seconds.",
                    "retry_after_seconds": retry_after,
                }, {"Retry-After": str(retry_after)})
                return
        except (OSError, KeyError, ValueError, json.JSONDecodeError):
            self.send_json(HTTPStatus.INTERNAL_SERVER_ERROR, {"error": "Authentication is not configured correctly."})
            return
        try:
            incoming = self.read_json()
        except (OSError, TypeError, ValueError, json.JSONDecodeError):
            self.send_json(HTTPStatus.BAD_REQUEST, {"error": "The login request must be a valid JSON object."})
            return
        try:
            username = str(incoming.get("username", ""))
            password = str(incoming.get("password", ""))
            client_kind = str(incoming.get("client_kind", "unknown")).lower()
            if client_kind not in {"web", "ios", "windows", "test", "unknown"}:
                client_kind = "unknown"
            candidate = hashlib.pbkdf2_hmac(
                "sha256", password.encode(), bytes.fromhex(config["salt_hex"]),
                int(config["pbkdf2_sha256_iterations"]),
            ).hex()
            username_valid = hmac.compare_digest(username, str(config["username"]))
            password_valid = hmac.compare_digest(candidate, str(config["password_hash_hex"]))
            valid = username_valid & password_valid
            if not valid:
                with AUTH_LOCK:
                    FAILURES.setdefault(ip, []).append(now)
                self.send_json(HTTPStatus.UNAUTHORIZED, {"error": "Incorrect username or password."})
                return
            token = secrets.token_urlsafe(32)
            seconds = int(config["session_seconds"])
            revoked: list[str] = []
            with AUTH_LOCK:
                FAILURES.pop(ip, None)
                for key in [
                    key for key, (_, session_ip, session_kind) in SESSIONS.items()
                    if session_ip == ip and session_kind == client_kind
                ]:
                    SESSIONS.pop(key, None)
                    revoked.append(key)
                SESSIONS[token] = (now + seconds, ip, client_kind)
            for key in revoked:
                release_input_session(key)
            self.send_json(HTTPStatus.OK, {
                "session": token, "expires_seconds": seconds, "username": config["username"],
                "fresh_connection": True, "client_kind": client_kind,
                "previous_same_client_sessions_revoked": True,
            })
        except (KeyError, TypeError, ValueError):
            self.send_json(HTTPStatus.INTERNAL_SERVER_ERROR, {"error": "Authentication is not configured correctly."})

    def logout(self) -> None:
        supplied = self.session_token()
        with AUTH_LOCK:
            SESSIONS.pop(supplied, None)
        release_input_session(supplied)
        # Logout ignores its body, so never reinterpret unread bytes as a new
        # HTTP/1.1 request on this authenticated connection.
        self.close_connection = True
        self.send_json(HTTPStatus.OK, {"status": "logged_out"}, {"Connection": "close"})

    def require_auth(self) -> bool:
        if self.authenticated():
            return True
        self.send_json(HTTPStatus.UNAUTHORIZED, {"error": "Please sign in to the board."})
        return False

    def do_GET(self) -> None:
        self.request_started = time.perf_counter()
        self.request_id = secrets.token_hex(6)
        path = self.path.split("?", 1)[0]
        if path == '/api/wifi':
            if not self.require_auth(): return
            with WIFI_LOCK:
                job = {k: v for k, v in WIFI_JOB.items() if k != 'token'} if WIFI_JOB.get('token') == self.session_token() else {}
                busy = WIFI_JOB.get('state') == 'connecting'
            try:
                value = {'current': {'state': 'SWITCHING'}, 'saved': [], 'busy': True} if busy else wifi_helper({'action': 'status'})
                value['job'] = job
                value['password_entry_allowed'] = self.client_address[0] == '127.0.0.1'
                self.send_json(HTTPStatus.OK, value)
            except (OSError, ValueError):
                self.send_json(HTTPStatus.SERVICE_UNAVAILABLE, {'error': 'Wi-Fi controls are unavailable. USB/SSH and existing saved networks are unchanged.'})
            return
        if path == "/api/desktop/frame":
            if not self.require_auth(): return
            if self.client_address[0] != '10.42.0.2' or not isinstance(self.connection, ssl.SSLSocket):
                self.send_json(HTTPStatus.FORBIDDEN, {'error':'Desktop is restricted to the paired ESP32 private link.'});return
            try:
                query=parse_qs(urlsplit(self.path).query,strict_parsing=True,max_num_fields=6)
                if set(query)-{'layout','zoom','cx','cy','base'} or any(len(v)!=1 for v in query.values()):raise ValueError('Invalid view')
                layout=query.get('layout',['portrait'])[0]
                layouts={'portrait':(320,240),'landscape':(336,252),'portrait-full':(320,480),'landscape-full':(480,320),'portrait-touch-full':(320,436),'landscape-touch-full':(480,276)}
                if layout not in layouts:raise ValueError('Invalid layout')
                width,height=layouts[layout]
                frame,viewport=desktop_capture.capture(width,height,int(query.get('zoom',['1'])[0]),int(query.get('cx',['5000'])[0]),int(query.get('cy',['5000'])[0]),with_viewport=True)
                base=query.get('base',[''])[0]
                if base and not re.fullmatch('[0-9a-f]{32}',base):raise ValueError('Invalid frame reference')
                frame_id=''
                if layout.endswith('-full'):frame,frame_id=desktop_capture.changed_rows(frame,width,height,viewport,base)
            except ValueError:
                self.send_json(HTTPStatus.BAD_REQUEST, {'error':'Invalid desktop view.'});return
            except (OSError, RuntimeError, subprocess.SubprocessError):
                self.send_json(HTTPStatus.SERVICE_UNAVAILABLE, {'error':'Desktop frame unavailable.'});return
            self.send_response(HTTPStatus.OK)
            self.send_header('Content-Type','application/octet-stream')
            self.send_header('X-Desktop-Viewport',','.join(map(str,viewport)))
            self.send_header('X-Desktop-Encoding','rle565-rows-v1' if layout.endswith('-full') else 'rgb565')
            self.send_header('X-Desktop-Frame',frame_id)
            focus = desktop_focus.snapshot()
            self.send_header('X-Desktop-Editable',str(focus['revision']) if focus['editable'] else '0')
            self.send_header('Content-Length',str(len(frame)))
            self.send_header('Cache-Control','no-store')
            self.send_header('X-Content-Type-Options','nosniff')
            self.end_headers();self.wfile.write(frame);return
        if path == "/api/identity":
            self.send_json(
                HTTPStatus.OK,
                {
                    "service": "orangepi-companion",
                    "schema": 1,
                    "identity": "orange-pi-drone-companion-v1",
                    "authority": "companion_advisory_only",
                    "access_point": display_access_point(),
                },
            )
            return
        if path == "/api/status":
            if self.require_auth():
                self.send_json(HTTPStatus.OK, system_status())
            return
        if path == '/api/follow-location':
            if self.require_auth():
                self.send_json(HTTPStatus.OK, {'follow_location': PHONE_LOCATION.snapshot()})
            return
        if path in {'/api/display', '/api/display-telemetry'}:
            if self.require_auth():
                self.send_json(HTTPStatus.OK, display_snapshot())
            return
        if path == "/api/flight":
            if self.require_auth():
                self.send_json(HTTPStatus.OK, live_flight_status())
            return
        if path == "/api/profile":
            if not self.require_auth():
                return
            try:
                self.send_json(HTTPStatus.OK, json.loads(PROFILE.read_text(encoding="utf-8")))
            except (OSError, json.JSONDecodeError):
                self.send_json(HTTPStatus.OK, {"files": 0, "status": "No flight logs have been analyzed yet."})
            return
        if path == "/api/batteries":
            if not self.require_auth(): return
            try:
                self.send_json(HTTPStatus.OK, battery_store().summary(BATTERY_ROOT))
            except (ImportError, OSError, ValueError, TypeError):
                self.send_json(HTTPStatus.SERVICE_UNAVAILABLE, {'error': 'Battery history could not be verified. Existing records were not changed.'})
            return
        if path == "/api/updates":
            if self.require_auth():
                self.send_json(HTTPStatus.OK, update_status())
            return
        if path == "/api/insights":
            if self.require_auth():
                self.send_json(HTTPStatus.OK, flight_insights())
            return
        if path == "/api/learning":
            if self.require_auth(): self.send_json(HTTPStatus.OK, learning_review_status())
            return
        relative = "index.html" if path == "/" else path.lstrip("/")
        target = (APP / relative).resolve()
        if APP.resolve() not in target.parents and target != APP.resolve():
            self.send_error(HTTPStatus.NOT_FOUND)
            return
        if not target.is_file():
            self.send_error(HTTPStatus.NOT_FOUND)
            return
        mime = {
            ".html": "text/html; charset=utf-8", ".js": "text/javascript; charset=utf-8",
            ".css": "text/css; charset=utf-8", ".webmanifest": "application/manifest+json",
            ".svg": "image/svg+xml",
        }.get(target.suffix, "application/octet-stream")
        body = target.read_bytes()
        self.send_response(HTTPStatus.OK)
        self.send_header("Content-Type", mime)
        self.security_headers()
        self.send_header("Cross-Origin-Opener-Policy", "same-origin")
        self.send_header("Content-Security-Policy", "default-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; style-src 'self'; img-src 'self' data:; connect-src 'self'; script-src 'self'; manifest-src 'self'")
        self.send_header("Cache-Control", "no-cache" if target.name in {"index.html", "service-worker.js", "app.js", "style.css"} else "public, max-age=86400")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self) -> None:
        self.request_started = time.perf_counter()
        self.request_id = secrets.token_hex(6)
        path = self.path.split("?", 1)[0]
        if path == "/api/login":
            self.login()
            return
        if not self.require_auth():
            return
        if path == '/api/phone-quick-connect':
            self.phone_quick_connect()
        elif path == '/api/follow-location':
            self.follow_location_action()
        elif path == '/api/update-policy':            self.update_policy_action()
        elif path in {'/api/wifi/scan', '/api/wifi/save', '/api/wifi/connect', '/api/wifi/updates'}:
            self.wifi_action(path.rsplit('/', 1)[1])
        elif path in {'/api/learning/review', '/api/learning/approve'}:
            self.learning_action(path.rsplit('/', 1)[1])
        elif path in {'/api/batteries/register', '/api/batteries/assign'}:
            self.battery_action(path.rsplit('/', 1)[1])
        elif path == "/api/logout":
            self.logout()
        elif path == "/api/chat":
            self.proxy_chat()
        elif path == "/api/logs":
            self.upload_log()
        elif path == "/api/input":
            self.remote_input()
        else:
            self.send_error(HTTPStatus.NOT_FOUND)

    def phone_quick_connect(self) -> None:
        if not self.require_auth(): return
        # Only the authenticated display on the private AP may mint an owner QR.
        if self.headers.get('Origin') or self.client_address[0] != '10.42.0.2':
            self.send_json(HTTPStatus.FORBIDDEN, {'error': 'Paired display required.'}); return
        try:
            if self.headers.get('Content-Type', '').split(';')[0] != 'application/json' or self.read_json(maximum=128) != {}:
                raise ValueError('Empty JSON request required')
            from quick_connect import request_code
            self.send_json(HTTPStatus.OK, request_code())
        except (OSError, ValueError):
            self.send_json(HTTPStatus.SERVICE_UNAVAILABLE, {'error': 'Dashboard pairing unavailable. Retry shortly.'})

    def follow_location_action(self) -> None:
        # No browser-origin location writes: only the authenticated display bridge.
        if self.headers.get('Origin') or self.client_address[0] != '10.42.0.2':
            self.send_json(HTTPStatus.FORBIDDEN, {'error': 'Phone position requires the paired display bridge.'}); return
        try:
            if self.headers.get('Content-Type', '').split(';')[0] != 'application/json':
                raise ValueError('Expected JSON.')
            incoming = self.read_json(maximum=512)
            token = self.session_token()
            with AUTH_LOCK:
                session = SESSIONS.get(token)
                if not session or session[0] <= time.monotonic() or session[1] != self.client_address[0]:
                    self.send_json(HTTPStatus.UNAUTHORIZED, {'error': 'Sign in again.'}); return
                value = PHONE_LOCATION.accept(incoming)
            self.send_json(HTTPStatus.OK, {'follow_location': value})
        except (OSError, ValueError, TypeError, KeyError):
            self.send_json(HTTPStatus.BAD_REQUEST, {'error': 'Phone position rejected: verify freshness, accuracy and ordering.'})

    def update_policy_action(self) -> None:
        origin = self.headers.get('Origin')
        if origin:
            parsed = urlsplit(origin)
            if parsed.scheme not in {'http', 'https'} or parsed.netloc != self.headers.get('Host') or parsed.path or parsed.query or parsed.fragment:
