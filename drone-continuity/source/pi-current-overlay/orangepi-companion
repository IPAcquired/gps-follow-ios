                # Model output is untrusted data: bound bytes before JSON parsing
                # and require actual text before the advisory safety filter.
                with request.urlopen(upstream, timeout=120) as response:
                    raw = response.read(1024 * 1024 + 1)
                if len(raw) > 1024 * 1024:
                    raise ValueError("Model response too large")
                answer = json.loads(raw)
                if not isinstance(answer, dict) or not isinstance(answer.get("choices"), list) or not answer["choices"]:
                    raise ValueError("Invalid model response")
                choice = answer["choices"][0]
                if not isinstance(choice, dict) or not isinstance(choice.get("message"), dict):
                    raise ValueError("Invalid model message")
                text = choice["message"].get("content")
                if not isinstance(text, str) or not text.strip():
                    raise ValueError("Model response was not text")
            except (OSError, ValueError, TypeError, RecursionError, HTTPException):
                self.send_json(HTTPStatus.SERVICE_UNAVAILABLE, {"error": "The onboard AI returned an unavailable or invalid response. No action was taken; retry your question when it is ready."})
                return
            if unsafe_model_answer(text):
                text = (
                    "That generated answer failed the flight-authority safety check and was blocked. "
                    "The MicoAir H743 remains authoritative; the Orange Pi does not write ArduPilot "
                    "parameters or directly command actuators."
                )
            self.send_json(HTTPStatus.OK, {
                "answer": text,
                "model": "onboard-fast-guarded",
                "verification": "unverified_generated_text",
                "authority": "advisory_only",
            })
        except (ValueError, KeyError, json.JSONDecodeError) as exc:
            self.send_json(HTTPStatus.BAD_REQUEST, {"error": str(exc)})
        except (error.URLError, TimeoutError):
            self.send_json(HTTPStatus.SERVICE_UNAVAILABLE, {"error": "The onboard AI is temporarily unavailable."})

    def upload_log(self) -> None:
        name = self.headers.get("X-Filename", "flight.bin")
        safe = "".join(c if c.isalnum() or c in "._-" else "_" for c in Path(name).name)
        if not safe.lower().endswith(".bin"):
            self.send_json(HTTPStatus.BAD_REQUEST, {"error": "Only ArduPilot .BIN logs are accepted."})
            return
        try:
            length = self.request_body_length()
        except (TypeError, ValueError):
            self.send_json(HTTPStatus.BAD_REQUEST, {"error": "The log upload needs one valid Content-Length and no transfer encoding."})
            return
        # Reserve one writer, not disk capacity independently for parallel
        # uploads. A rejected/ambiguous upload is never automatically replayed.
        if not UPLOAD_LOCK.acquire(blocking=False):
            self.send_json(HTTPStatus.TOO_MANY_REQUESTS, {"error": "Another flight log is uploading. Check its result before submitting another."})
            return
        temporary = None
        try:
            if not self.authenticated():
                self.send_json(HTTPStatus.UNAUTHORIZED, {"error": "Please sign in to the board."}); return
            INBOX.mkdir(parents=True, exist_ok=True, mode=0o700)
            free = shutil.disk_usage(INBOX).free
            if length <= 0 or length + MIN_FREE > free:
                self.send_json(HTTPStatus.INSUFFICIENT_STORAGE, {"error": "Not enough free space, or the upload size is missing."}); return
            digest = hashlib.sha256()
            fd, temporary = tempfile.mkstemp(prefix=".upload-", suffix=".part", dir=INBOX)
            remaining = length
            with os.fdopen(fd, "wb") as handle:
                while remaining:
                    chunk = self.rfile.read(min(4 * 1024 * 1024, remaining))
                    if not chunk:
                        raise ConnectionError("Upload ended early")
                    handle.write(chunk)
                    digest.update(chunk)
                    remaining -= len(chunk)
                handle.flush()
                os.fsync(handle.fileno())
            destination = INBOX / f"{int(time.time())}-{digest.hexdigest()[:12]}-{safe}"
            # Logout/new-login/expiry while a large body is arriving cannot
            # make the old session's temporary upload durable or analyzable.
            with AUTH_LOCK:
                session = SESSIONS.get(self.session_token())
                if not session or session[0] <= time.monotonic() or session[1] != self.client_address[0]:
                    self.send_json(HTTPStatus.UNAUTHORIZED, {"error": "Session ended before the upload was committed. Refresh log history before retrying."}); return
                os.chmod(temporary, 0o600)
                os.replace(temporary, destination)
                temporary = None
            self.send_json(HTTPStatus.CREATED, {"status": "queued_for_analysis", "name": destination.name, "bytes": length, "sha256": digest.hexdigest()})
        except Exception:
            self.send_json(HTTPStatus.BAD_REQUEST, {"error": "The flight-log upload could not be completed."})
        finally:
            if temporary is not None:
                try: os.unlink(temporary)
                except OSError: pass
            UPLOAD_LOCK.release()


class CompanionServer(ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True
    request_queue_size = 16

    def process_request(self, client, address):
        if not HTTP_CONNECTION_SLOTS.acquire(blocking=False):
            # Fail closed before spawning a worker; no mutation was accepted.
            self.shutdown_request(client)
            return
        try:
            super().process_request(client, address)
        except BaseException:
            HTTP_CONNECTION_SLOTS.release()
            raise

    def process_request_thread(self, client, address):
        try:
            super().process_request_thread(client, address)
        finally:
            HTTP_CONNECTION_SLOTS.release()

    def get_request(self):
        client, address = super().get_request()
        try:
            # Small authenticated HTTP replies use separate header/body writes.
            # Avoid a Nagle/delayed-ACK stall on this companion TCP socket only.
            client.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        except OSError:
            client.close()
            raise
        return client, address


