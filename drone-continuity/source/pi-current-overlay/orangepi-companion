def wifi_helper(payload: dict, timeout: float = 5) -> dict:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(timeout)
        client.connect('/run/orangepi-wifi-control.sock')
        client.sendall(json.dumps(payload).encode() + b'\n')
        raw = client.makefile('rb').readline(65537)
        if len(raw) > 65536 or not raw.endswith(b'\n'):
            raise ValueError('Invalid Wi-Fi helper response.')
        value = json.loads(raw)
        if not isinstance(value, dict): raise ValueError('Invalid Wi-Fi helper response.')
        return value


def wifi_connect_worker(ssid: str, job_id: str, token: str) -> None:
    # Give the caller time to receive the job id before switching its Wi-Fi path.
    time.sleep(2)
    expire_sessions()
    with AUTH_LOCK:
        current = SESSIONS.get(token)
    if not current or current[0] <= time.monotonic():
        result = {'state': 'cancelled', 'detail': 'Session ended before Wi-Fi switching began.'}
    else:
        try: result = wifi_helper({'action': 'connect', 'ssid': ssid}, timeout=45)
        except (OSError, ValueError): result = {'error': 'Wi-Fi helper did not confirm the result. Check connection status; the request was not replayed.'}
    with WIFI_LOCK:
        if WIFI_JOB.get('id') == job_id:
            WIFI_JOB.update(result)
            if 'error' in result: WIFI_JOB['state'] = 'failed'


class RemoteInput:
    """Small, allow-listed X11 input bridge; never executes client supplied commands."""

    BUTTONS = {"left": 1, "middle": 2, "right": 3}
    SPECIAL_KEYS = {
        "enter": "Return", "return": "Return", "backspace": "BackSpace",
        "tab": "Tab", "escape": "Escape", "esc": "Escape", "delete": "Delete",
        "arrowleft": "Left", "arrowright": "Right", "arrowup": "Up", "arrowdown": "Down",
        "home": "Home", "end": "End", "pageup": "Prior", "pagedown": "Next",
        "space": "space",
    }
    MODIFIERS = {"ctrl": "Control_L", "alt": "Alt_L", "shift": "Shift_L", "meta": "Super_L"}
    SHIFTED = {
        "!": "1", "@": "2", "#": "3", "$": "4", "%": "5", "^": "6",
        "&": "7", "*": "8", "(": "9", ")": "0", "_": "minus", "+": "equal",
        "{": "bracketleft", "}": "bracketright", "|": "backslash", ":": "semicolon",
        '"': "apostrophe", "<": "comma", ">": "period", "?": "slash", "~": "grave",
    }
    UNSHIFTED = {
        "-": "minus", "=": "equal", "[": "bracketleft", "]": "bracketright",
        "\\": "backslash", ";": "semicolon", "'": "apostrophe", ",": "comma",
        ".": "period", "/": "slash", "`": "grave", " ": "space",
    }

    def __init__(self) -> None:
        self.error = ""
        self.lock = threading.Lock()
        self.binary = shutil.which("xdotool")

    def _run(self, *arguments: str, timeout: float = 2.0) -> None:
        if not self.binary:
            raise RuntimeError("The desktop input package is not installed")
        environment = os.environ.copy()
        environment.update({"DISPLAY": ":0", "XAUTHORITY": "/home/drone/.Xauthority"})
        try:
            result = subprocess.run(
                [self.binary, *arguments], capture_output=True, text=True,
                timeout=timeout, check=False, env=environment,
            )
        except (OSError, subprocess.SubprocessError) as exc:
            raise RuntimeError(f"Desktop input failed: {exc}") from exc
        if result.returncode:
            detail = (result.stderr or result.stdout).strip()
            raise RuntimeError(detail or "The Orange Pi desktop rejected the input")

    def available(self) -> bool:
        try:
            with self.lock:
                self._run("getmouselocation", "--shell")
            return True
        except (OSError, subprocess.SubprocessError, RuntimeError):
            return False

    def _character(self, value: str) -> tuple[str, bool]:
        if value in self.SHIFTED:
            return self.SHIFTED[value], True
        if value in self.UNSHIFTED:
            return self.UNSHIFTED[value], False
        if len(value) == 1 and value.isalpha():
            return value.lower(), value.isupper()
        if len(value) == 1 and value.isdigit():
            return value, False
        raise ValueError("Only printable US keyboard characters are accepted")

    def move(self, dx: int, dy: int) -> None:
        with self.lock:
            self._run("mousemove_relative", "--", str(dx), str(dy))

    def button(self, button: int, pressed: bool) -> None:
        with self.lock:
            self._run("mousedown" if pressed else "mouseup", str(button))

    def click(self, button: int) -> None:
        with self.lock:
            self._run("click", str(button))

    def scroll(self, horizontal: int, vertical: int) -> None:
        for _ in range(abs(vertical)):
            self.click(5 if vertical > 0 else 4)
        for _ in range(abs(horizontal)):
            self.click(7 if horizontal > 0 else 6)

    def key(self, key: str, modifiers: list[str] | None = None) -> None:
        lowered = key.lower()
        shifted = False
        if lowered in self.SPECIAL_KEYS:
            keysym_name = self.SPECIAL_KEYS[lowered]
        elif len(key) == 1:
            keysym_name, shifted = self._character(key)
        else:
            raise ValueError("That keyboard key is not allowed")
        requested = [item.lower() for item in (modifiers or [])]
        if any(item not in self.MODIFIERS for item in requested):
            raise ValueError("Unknown keyboard modifier")
        requested = list(dict.fromkeys(requested))
        if shifted and "shift" not in requested:
            requested.append("shift")
        chord = "+".join([self.MODIFIERS[item] for item in requested[:4]] + [keysym_name])
        with self.lock:
            self._run("key", "--clearmodifiers", chord)

    def text(self, value: str) -> None:
        if not value or len(value) > 256:
            raise ValueError("Text input must contain 1 to 256 characters")
        if any(character not in "\n\t" and not 32 <= ord(character) <= 126 for character in value):
            raise ValueError("Only printable US keyboard text is accepted")
        with self.lock:
            buffer = ""
            for character in value:
                if character not in "\n\t":
                    buffer += character
                    continue
                if buffer:
                    self._run("type", "--clearmodifiers", "--delay", "0", "--", buffer, timeout=4.0)
                    buffer = ""
                self._run("key", "--clearmodifiers", "Return" if character == "\n" else "Tab")
            if buffer:
                self._run("type", "--clearmodifiers", "--delay", "0", "--", buffer, timeout=4.0)


