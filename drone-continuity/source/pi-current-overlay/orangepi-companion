def browser_owner_safe():
    state=read_json(MAVLINK_STATUS,{})
    now=time.time()
    stamp=state.get('updated_unix')
    if (state.get('authority')!='read_only_no_mavlink_transmit' or type(stamp) not in (int,float)
            or not math.isfinite(stamp) or not 0<=now-stamp<3):return False
