    def battery_action(self, action: str) -> None:
        """Owner-confirmed, append-only identification of completed log records."""
        origin = self.headers.get('Origin')
        if origin and origin != 'http://' + self.headers.get('Host', ''):
            self.send_json(HTTPStatus.FORBIDDEN, {'error': 'Battery changes must originate from this companion page.'}); return
        try:
            if self.headers.get('Content-Type', '').split(';')[0].strip() != 'application/json':
                raise ValueError('Expected JSON.')
            value = self.read_json(maximum=4096)
            expected = {'label', 'confirm'} if action == 'register' else {'flight_log_sha256', 'instance', 'pack_id', 'confirm'}
            if set(value) != expected or value.get('confirm') is not True:
                raise ValueError('Explicit confirmation required.')
            if action == 'register':
                label = value['label']
                if not isinstance(label, str) or not 1 <= len(label.strip()) <= 60 or any(ord(c) < 32 or ord(c) == 127 for c in label):
                    raise ValueError('Invalid battery label.')
            else:
                sha, instance, pack_id = value['flight_log_sha256'], value['instance'], value['pack_id']
                if not isinstance(sha, str) or not re.fullmatch('[0-9a-f]{64}', sha): raise ValueError('Invalid log hash.')
                if isinstance(instance, bool) or not isinstance(instance, int) or not 0 <= instance <= 8: raise ValueError('Invalid battery instance.')
                if not isinstance(pack_id, str) or not re.fullmatch('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}', pack_id):
                    raise ValueError('Invalid physical battery identity.')
        except (ValueError, TypeError, KeyError, OSError):
            self.send_json(HTTPStatus.BAD_REQUEST, {'error': 'Invalid battery request. Use a registered physical pack and an exact completed log/monitor record.'}); return
        token = self.session_token()
        with BATTERY_ACTION_LOCK:
            # Authentication is rechecked after any wait; fresh sessions cannot
            # inherit or replay an older connection's pending assignment.
            if not self.authenticated():
                self.send_json(HTTPStatus.UNAUTHORIZED, {'error': 'Please sign in to the board.'}); return
            now = time.monotonic()
            if now - BATTERY_RATE.get(token, -100) < 2:
                self.send_json(HTTPStatus.TOO_MANY_REQUESTS, {'error': 'Wait two seconds, then refresh battery history before another change.'}); return
            if len(BATTERY_RATE) >= 128: BATTERY_RATE.clear()
            BATTERY_RATE[token] = now
            try:
                guard = wifi_helper({'action': 'bench'})
                if guard.get('bench') is not True:
                    raise ValueError('Battery identification is bench-only.')
                store = battery_store()
                # Bench verification may wait on a root helper. A session that
                # ended during that wait must not commit a durable assignment.
                with AUTH_LOCK:
                    session = SESSIONS.get(token)
                    if not session or session[0] <= time.monotonic() or session[1] != self.client_address[0]:
                        self.send_json(HTTPStatus.UNAUTHORIZED, {'error': 'Please sign in to the board.'}); return
                    result = store.register_pack(BATTERY_ROOT, label.strip()) if action == 'register' else store.assign_pack(BATTERY_ROOT, sha, instance, pack_id)
                self.send_json(HTTPStatus.OK, {'state': 'registered' if action == 'register' else 'assigned', 'record': result, 'detail': 'Physical battery profile saved. No future flight is automatically assigned.' if action == 'register' else 'This completed log/monitor record is linked to this physical pack. Other packs and future flights are unchanged.'})
            except (ImportError, ValueError, TypeError, KeyError, OSError):
                self.send_json(HTTPStatus.CONFLICT, {'error': 'Battery change could not complete safely. Check bench status and refresh history; an existing assignment cannot be overwritten. The request was not replayed.'})

    def learning_action(self, action: str) -> None:
        origin = self.headers.get('Origin')
        if origin and origin != 'http://' + self.headers.get('Host', ''):
            self.send_json(HTTPStatus.FORBIDDEN, {'error': 'Review must originate from this companion page.'}); return
        try:
            value = self.read_json(maximum=4096)
            expected = {'kind', 'candidate_id'} if action == 'review' else {'kind', 'candidate_id', 'approval_sha256', 'review_ticket'}
            if set(value) != expected: raise ValueError('Invalid review fields.')
            kind, candidate_id = value['kind'], value['candidate_id']
            if kind not in {'flight_policy', 'fast_model_policy'} or not isinstance(candidate_id, str) or not re.fullmatch('[0-9a-f]{24}', candidate_id): raise ValueError('Invalid candidate identity.')
            folder = FLIGHT_LEARNING_ROOT / 'candidates' if kind == 'flight_policy' else AI_IMPROVEMENT_ROOT / 'pending'
            path = folder / (candidate_id + '.json')
            if path.is_symlink() or path.stat().st_size > 1024*1024: raise ValueError('Invalid candidate file.')
            candidate = json.loads(path.read_text())
            if not isinstance(candidate, dict) or not isinstance(candidate.get('approval_payload', {}), dict): raise ValueError('Invalid candidate structure.')
            approval = candidate.get('approval_sha256', '')
            if not isinstance(approval, str) or not re.fullmatch('[0-9a-f]{64}', approval): raise ValueError('Invalid approval identity.')
            token = self.session_token()
            if action == 'review':
                ticket = secrets.token_urlsafe(24)
                with LEARNING_REVIEW_LOCK:
                    now = time.monotonic()
                    for expired in [key for key,item in REVIEW_TICKETS.items() if item[3] <= now]: REVIEW_TICKETS.pop(expired,None)
                    if len(REVIEW_TICKETS) >= 128: raise ValueError('Too many review sessions.')
                    REVIEW_TICKETS[ticket] = (token, candidate_id, kind + ':' + approval, now + 600)
                self.send_json(HTTPStatus.OK, {'kind':kind,'candidate_id':candidate_id,'approval_sha256':approval,'review_ticket':ticket,'status':candidate.get('status'),'proposal':candidate.get('approval_payload', {}).get('candidate', {}),'report':candidate.get('report',candidate.get('evaluation', {})),'authority':'companion_advisory_only'}); return
            if value['approval_sha256'] != approval: raise ValueError('Candidate changed; review it again.')
            if not isinstance(value['review_ticket'], str) or not 1 <= len(value['review_ticket']) <= 128: raise ValueError('Invalid review ticket.')
            with LEARNING_REVIEW_LOCK:
                ticket_value = REVIEW_TICKETS.pop(value['review_ticket'],None)
            if not ticket_value or ticket_value[:3] != (token,candidate_id,kind+':'+approval) or ticket_value[3] <= time.monotonic(): raise ValueError('Review ticket expired or belongs to another session. Review again.')
            guard = wifi_helper({'action':'bench'})
            if guard.get('bench') is not True: raise ValueError('Approval paused: disconnect flight hardware/session or finish maintenance first.')
            executable = '/home/drone/bin/orangepi-flight-learning' if kind == 'flight_policy' else '/home/drone/bin/orangepi-ai-improvement'
            with LEARNING_REVIEW_LOCK:
                # A fresh login or expiry during the bench/approval-lock wait
                # must not let an older reviewed session commit a policy.
                with AUTH_LOCK:
                    session = SESSIONS.get(token)
                    if not session or session[0] <= time.monotonic() or session[1] != self.client_address[0]:
                        self.send_json(HTTPStatus.UNAUTHORIZED, {'error': 'Please sign in to the board.'}); return
                result = subprocess.run(['/usr/bin/python3',executable,'approve',candidate_id,'--confirm-sha256',approval],stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=15)
            if result.returncode != 0: raise ValueError('Candidate gate rejected approval, was busy, or has already been decided. Refresh and review its report; nothing was replayed.')
            self.send_json(HTTPStatus.OK, {'state':'approved','candidate_id':candidate_id,'approval_sha256':approval,'detail':'Exact reviewed advisory policy approved. Immutable decision and parent version retained; H743 settings unchanged.'})
        except (ValueError,TypeError,KeyError,OSError,subprocess.SubprocessError):
            self.send_json(HTTPStatus.CONFLICT, {'error':'Review/approval could not complete safely. Check candidate gates, active-policy changes and bench status, then refresh; the request was not replayed.'})

    def request_body_length(self, maximum: int | None = None) -> int:
        # A fixed-length-only API must reject ambiguous framing before it reads
        # or dispatches a body. Chunked transfer is not implemented here.
        lengths = self.headers.get_all("Content-Length", [])
        if self.headers.get_all("Transfer-Encoding", []) or len(lengths) != 1:
            raise ValueError("Invalid request framing")
        value = lengths[0].strip(" \t")
        if not re.fullmatch(r"[0-9]{1,20}", value):
            raise ValueError("Invalid request size")
        length = int(value)
        if not 0 < length <= 9_223_372_036_854_775_807 or (maximum is not None and length > maximum):
            raise ValueError("Invalid request size")
        return length

    def read_json(self, maximum: int = 1024 * 1024) -> dict:
        length = self.request_body_length(maximum)
        raw = self.rfile.read(length)
        if len(raw) != length:
            raise ValueError("Incomplete request body")
        try:
            value = json.loads(raw)
        except (UnicodeError, RecursionError):
            raise ValueError("Invalid JSON body") from None
        if not isinstance(value, dict):
            raise ValueError("The JSON body must be an object")
        return value

    @staticmethod
    def bounded_integer(value: object, minimum: int, maximum: int) -> int:
        number = float(value)
        if not math.isfinite(number):
            raise ValueError("Input values must be finite numbers")
        return max(minimum, min(maximum, int(round(number))))

    def remote_input(self) -> None:
        if self.client_address[0] != '10.42.0.2' or not isinstance(self.connection, ssl.SSLSocket):
            self.send_json(HTTPStatus.FORBIDDEN, {'error':'Desktop input is restricted to the paired ESP32.'});return
        token = self.session_token()
        try:
            incoming = self.read_json(4096)
            action = str(incoming.get("action", "")).lower()
            flight=live_flight_status()
            if action not in {'probe','release_all'} and flight.get('connected') is True and flight.get('armed') is not False:
                self.send_json(HTTPStatus.CONFLICT, {'error':'Desktop input blocked while armed state is unsafe or unknown.'});return
            event_id = incoming.get("event_id")
            if isinstance(event_id, bool) or not isinstance(event_id, int) or not 1 <= event_id <= 9_007_199_254_740_991:
                raise ValueError("A positive integer input event_id is required")
            with INPUT_LOCK:
                execution_lock = INPUT_EXECUTION_LOCKS.setdefault(token, threading.RLock())
            with execution_lock:
                # Authentication is checked again after waiting for older input.
                # A revoked session therefore cannot replay a queued event.
                with AUTH_LOCK:
                    session = SESSIONS.get(token)
                    if not session or session[0] <= time.monotonic() or session[1] != self.client_address[0]:
                        self.send_json(HTTPStatus.UNAUTHORIZED, {"error": "Please sign in to the board."})
                        return
                with INPUT_LOCK:
                    last_event = LAST_INPUT_EVENT.get(token, -1)
                    if event_id <= last_event:
                        self.send_json(HTTPStatus.CONFLICT, {"error": "Stale or duplicate input event rejected."})
                        return
                    LAST_INPUT_EVENT[token] = event_id
                # Safety release must remain available even after a burst exhausts
                # the normal pointer/keyboard rate allowance.
                if action != "release_all" and not input_rate_allowed(token):
                    self.send_json(HTTPStatus.TOO_MANY_REQUESTS, {"error": "Remote input rate limit reached."})
                    return
                if action == "probe":
                    if not REMOTE_INPUT.available():
                        raise RuntimeError("The Orange Pi graphical desktop is not available")
                elif action in {"point", "tap"}:
                    desktop_capture.point(incoming.get('x'), incoming.get('y'), click=action == "tap")
                elif action == "move":
                    dx = self.bounded_integer(incoming.get("dx", 0), -200, 200)
                    dy = self.bounded_integer(incoming.get("dy", 0), -200, 200)
                    if dx or dy:
                        REMOTE_INPUT.move(dx, dy)
                elif action == "click":
                    name = str(incoming.get("button", "left")).lower()
                    if name not in REMOTE_INPUT.BUTTONS:
                        raise ValueError("Unknown pointer button")
                    REMOTE_INPUT.click(REMOTE_INPUT.BUTTONS[name])
                elif action == "button":
                    name = str(incoming.get("button", "left")).lower()
                    state = str(incoming.get("state", "")).lower()
                    if name not in REMOTE_INPUT.BUTTONS or state not in {"down", "up"}:
                        raise ValueError("Invalid pointer button state")
                    button = REMOTE_INPUT.BUTTONS[name]
                    if state == "down":
                        # A desktop subprocess can press before its timeout or
                        # error is reported. Retain conservative ownership so
                        # release_all/watchdog can undo an ambiguous down.
                        with INPUT_LOCK:
                            held = HELD_BUTTONS.setdefault(token, set())
                            now = time.monotonic()
                            first_held = HELD_INPUT_TIMES.get(token, (now, now))[0]
                            held.add(button)
                            HELD_INPUT_TIMES[token] = (first_held, now)
                    REMOTE_INPUT.button(button, state == "down")
                    if state == "up":
                        with INPUT_LOCK:
                            held = HELD_BUTTONS.setdefault(token, set())
                            held.discard(button)
                            if not held:
                                HELD_BUTTONS.pop(token, None)
                                HELD_INPUT_TIMES.pop(token, None)
                            else:
                                now = time.monotonic()
                                held_since, _ = HELD_INPUT_TIMES.get(token, (now, now))
                                HELD_INPUT_TIMES[token] = (held_since, now)
                elif action == "scroll":
                    horizontal = self.bounded_integer(incoming.get("dx", 0), -8, 8)
                    vertical = self.bounded_integer(incoming.get("dy", 0), -8, 8)
                    if horizontal or vertical:
                        REMOTE_INPUT.scroll(horizontal, vertical)
                elif action == "key":
                    modifiers = incoming.get("modifiers", [])
                    if not isinstance(modifiers, list) or len(modifiers) > 4:
                        raise ValueError("Invalid keyboard modifiers")
                    REMOTE_INPUT.key(str(incoming.get("key", "")), [str(item) for item in modifiers])
                elif action == "text":
                    REMOTE_INPUT.text(str(incoming.get("text", "")))
                elif action == "desktop_app":
                    desktop_workspace.launch(str(incoming.get('key','')))
                elif action == "release_all":
                    if not release_input_session(token):
                        raise RuntimeError("Remote input release was not confirmed")
                else:
                    raise ValueError("Unknown remote input action")
                if action not in {"button", "release_all"}:
                    with INPUT_LOCK:
                        if HELD_BUTTONS.get(token):
                            now = time.monotonic()
                            held_since, _ = HELD_INPUT_TIMES.get(token, (now, now))
                            HELD_INPUT_TIMES[token] = (held_since, now)
            self.send_json(HTTPStatus.OK, {
                "status": "accepted", "action": action,
                "session_bound": True, "arbitrary_commands": False,
                "event_id": event_id,
                "server_completed_unix_ms": int(time.time() * 1000),
                "input_processing_ms": round(max(0.0, (time.perf_counter() - self.request_started) * 1000), 3),
                "held_input_idle_release_seconds": int(HELD_INPUT_IDLE_SECONDS),
                "held_input_absolute_release_seconds": int(HELD_INPUT_MAX_SECONDS),
            })
        except (OverflowError, TypeError, ValueError) as exc:
            self.send_json(HTTPStatus.BAD_REQUEST, {"error": str(exc)})
        except RuntimeError as exc:
            self.send_json(HTTPStatus.SERVICE_UNAVAILABLE, {"error": str(exc)})

