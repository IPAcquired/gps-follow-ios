+def log_controller_group(analysis: dict) -> str:
+    """Classify the board and vehicle from complete, consistent DataFlash VER observations."""
+    count = analysis["message_types"].get("VER")
+    if type(count) is not int or count <= 0:
+        return "unassigned"
+    def integer(field, minimum, maximum):
+        stats = analysis["numeric_fields"].get("VER." + field, {})
+        value = stats.get("minimum")
+        if (type(stats.get("count")) is int and stats["count"] == count
+                and type(value) in (float, int) and minimum <= value <= maximum
+                and value == int(value) and value == stats.get("maximum") == stats.get("mean")):
+            return int(value)
+        return None
+    board = integer("APJ", 1, 65535)
+    board_type = integer("BT", 1, 255)
+    vehicle = integer("BU", 1, 255)
+    version = tuple(integer(key, 0, 255) for key in ("Maj", "Min", "Pat"))
+    if board is None:
+        return "unassigned"
+    if board_type is None or vehicle is None or None in version:
+        return f"APJ-{board}/incomplete-version"
+    return f"APJ-{board}/BT-{board_type}/BU-{vehicle}/" + ".".join(map(str, version))
+
+
+CURRENT_GROUP = "APJ-1229/BT-10/BU-2/4.7.3"
+
+
+class LogTotals:
+    def __init__(self):
+        self.files = self.bytes = self.messages = self.duration_files = 0
+        self.duration = 0.0
+        self.types = Counter()
+        self.fields = {}
+
+    def add(self, report):
+        analysis = report["analysis"]
+        self.files += 1
+        self.bytes += int(report["source"]["bytes"])
+        self.messages += int(analysis["messages"])
+        if analysis["duration_seconds"] is not None:
+            self.duration += float(analysis["duration_seconds"])
+            self.duration_files += 1
+        self.types.update(analysis["message_types"])
+        for name, value in analysis["numeric_fields"].items():
+            self.fields.setdefault(name, RunningStats()).merge(RunningStats.from_value(value))
+
+    def summary(self):
+        return {"files": self.files, "bytes": self.bytes, "messages": self.messages,
+                "duration_seconds": round(self.duration, 6), "duration_files": self.duration_files,
+                "message_types": dict(sorted(self.types.items())),
+                "numeric_fields": {name: stats.value() for name, stats in sorted(self.fields.items())}}
+
