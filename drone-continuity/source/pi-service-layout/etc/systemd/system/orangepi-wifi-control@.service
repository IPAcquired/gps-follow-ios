[Unit]
Description=Restricted companion Wi-Fi request

[Service]
ExecStart=/usr/local/sbin/orangepi-wifi-control
StandardInput=socket
StandardOutput=socket
StandardError=null
RuntimeDirectory=orangepi-wifi
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
StateDirectory=orangepi-wifi
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=50
RuntimeMaxSec=50
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/etc/netplan /run /var/lib/orangepi-wifi
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
MemoryMax=128M
TasksMax=16
