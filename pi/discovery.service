[Unit]
Description=Locally paired Orange Pi touchscreen
After=basic.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -B %h/.local/share/orange-pi-wired-desktop/current/auto_service.py run
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=default.target
