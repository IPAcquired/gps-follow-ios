+// Emergency battery-Land deferral is volatile, explicit and pilot-controlled.
+// It never changes battery thresholds, arming checks, thrust limits or PIDs.
+bool Copter::battery_pilot_override_input_valid() const
+{
+    const uint32_t fresh_limit_ms = MIN(rc().get_fs_timeout_ms(), 500U);
+    const RC_Channel *channel = rc().find_channel_for_option(RC_Channel::AUX_FUNC::BATTERY_PILOT_OVERRIDE);
+    const uint32_t receiver_ms = rc().last_receiver_input_ms();
+    const int8_t mode_channel = rc().flight_mode_channel_number();
+    int8_t requested_position;
+    // Honor the pilot's explicit Land selection before its debounced callback;
+    // this differs from an automatic battery Land with AltHold still selected.
+    if (mode_channel <= 0 || mode_channel > NUM_RC_CHANNELS ||
+        rc().get_valid_channel_count() < mode_channel ||
+        !rc().channel(mode_channel - 1)->get_mode_switch_pos(requested_position) ||
+        flight_modes[requested_position].get() == int8_t(Mode::Number::LAND)) {
+        return false;
+    }
+    return rc().has_valid_input() && !rc().has_active_overrides() &&
+           !failsafe.radio && receiver_ms != 0 && millis() - receiver_ms <= fresh_limit_ms &&
+           channel != nullptr && rc().get_valid_channel_count() >= channel->ch() &&
+           channel->get_radio_in() > RC_Channel::RC_MIN_LIMIT_PWM &&
+           channel->get_radio_in() < RC_Channel::RC_MAX_LIMIT_PWM &&
+           (!_battery_pilot_override_active ||
+            (channel->ch() == _battery_pilot_override_channel + 1U &&
+             channel->get_aux_switch_pos() == RC_Channel::AuxSwitchPos::HIGH));
+}
+
+void Copter::set_battery_pilot_override_switch(const RC_Channel::AuxSwitchPos position, const uint16_t source_index)
+{
+    const RC_Channel *channel = rc().find_channel_for_option(RC_Channel::AUX_FUNC::BATTERY_PILOT_OVERRIDE);
+    if (channel == nullptr || channel->ch() != source_index + 1U ||
+        channel->get_aux_switch_pos() != position) {
+        return;
+    }
+    if (position != RC_Channel::AuxSwitchPos::HIGH) {
+        end_battery_pilot_override();
+        _battery_pilot_override_low_seen = position == RC_Channel::AuxSwitchPos::LOW &&
+                                          battery_pilot_override_input_valid();
+        _battery_pilot_override_channel = _battery_pilot_override_low_seen ? source_index : UINT8_MAX;
+        return;
+    }
+
+    // Consume the edge even if entry fails; held HIGH is never an auto-retry.
+    const bool low_seen = _battery_pilot_override_low_seen &&
+                          _battery_pilot_override_channel == source_index;
+    _battery_pilot_override_low_seen = false;
+    if (!low_seen || !motors->armed() || ap.land_complete ||
+        !battery_pilot_override_input_valid() || !ekf_alt_ok() ||
+        (battery.has_failsafed() && battery.get_highest_failsafe_priority() != FAILSAFE_LAND_PRIORITY)) {
+        gcs().send_text(MAV_SEVERITY_WARNING, "Battery override rejected: fresh pilot edge required");
+        return;
+    }
+    if (!set_mode(Mode::Number::ALT_HOLD, ModeReason::AUX_FUNCTION)) {
+        return;
+    }
+
+    _battery_pilot_override_active = true;
+    _battery_pilot_override_channel = source_index;
+    _battery_land_replay = false;
+    // Battery actions are latched by AP_BattMonitor. Preserve a previous Land
+    // even if it fired before the pilot deliberately selected this override.
+    _battery_land_pending |= battery.has_failsafed() &&
+                             battery.get_highest_failsafe_priority() == FAILSAFE_LAND_PRIORITY;
+    gcs().send_text(MAV_SEVERITY_CRITICAL, "Emergency AltHold: battery Land deferred; pilot must land");
+}
+
+void Copter::end_battery_pilot_override()
+{
+    const bool was_active = _battery_pilot_override_active;
+    _battery_pilot_override_active = false;
+    _battery_pilot_override_low_seen = false;
+    if (!was_active) {
+        return;
+    }
+    gcs().send_text(MAV_SEVERITY_WARNING, "Battery pilot override ended");
+    // Queue the latched action outside any RC/mode transaction. A terminate or
+    // disarm before the next update cancels it instead of being overwritten.
+    _battery_land_replay |= _battery_land_pending;
+}
+
+void Copter::update_battery_pilot_override()
+{
+    if (!motors->armed() || ap.land_complete) {
+        _battery_pilot_override_active = false;
+        _battery_pilot_override_low_seen = false;
+        _battery_land_pending = false;
+        _battery_land_replay = false;
+        _battery_pilot_override_channel = UINT8_MAX;
+        return;
+    }
+    const bool input_valid = battery_pilot_override_input_valid();
+    if (_battery_pilot_override_active &&
+        (flightmode->mode_number() != Mode::Number::ALT_HOLD ||
+         !input_valid || !ekf_alt_ok())) {
+        end_battery_pilot_override();
+    }
+    // Lost input also invalidates a prepared LOW edge. Radio recovery while
+    // the switch remains HIGH requires another real LOW -> HIGH sequence.
+    if (!input_valid) {
+        _battery_pilot_override_low_seen = false;
+    } else if (!_battery_pilot_override_active) {
+        // Fresh physical LOW while airborne prepares a later debounced edge;
+        // a LOW held on the ground does not require an extra airborne toggle.
+        const RC_Channel *channel = rc().find_channel_for_option(RC_Channel::AUX_FUNC::BATTERY_PILOT_OVERRIDE);
+        if (channel->ch() != _battery_pilot_override_channel + 1U) {
+            _battery_pilot_override_low_seen = false;
+        }
+        const auto position = channel->get_aux_switch_pos();
+        if (position == RC_Channel::AuxSwitchPos::LOW) {
+            _battery_pilot_override_low_seen = true;
+            _battery_pilot_override_channel = channel->ch() - 1U;
+        } else if (position == RC_Channel::AuxSwitchPos::MIDDLE) {
+            _battery_pilot_override_low_seen = false;
+        }
+    }
+    if (_battery_land_replay) {
+        _battery_land_replay = false;
+        if (battery.has_failsafed() &&
+            battery.get_highest_failsafe_priority() == FAILSAFE_LAND_PRIORITY &&
+            !flightmode->is_landing()) {
+            announce_failsafe("Battery", "Restoring Landing");
+            do_failsafe_action(FailsafeAction::LAND, ModeReason::BATTERY_FAILSAFE);
+        }
+    }
+}
