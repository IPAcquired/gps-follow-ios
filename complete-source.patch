+
+void AC_Avoid::reset_adaptive_state()
+{
+    _adaptive_low_height = false;
+    for (uint8_t i = 0; i < ARRAY_SIZE(_adaptive_extra_cm); i++) {
+        _adaptive_extra_cm[i] = 0.0f;
+        _adaptive_sector_ms[i] = 0;
+    }
+}
+
+void AC_Avoid::proximity_avoidance_enable(bool on_off)
+{
+    if (!on_off) {
+        _dropout_hold_active = false;
+    }
+    if (_proximity_enabled && !on_off) {
+        reset_adaptive_state();
+        _adaptive_last_call_ms = 0;
+    }
+    _proximity_enabled = on_off;
+}
